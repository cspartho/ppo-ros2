<?xml version="1.0"?>
<package format="3">
  <name>ppo_ros2</name>
  <version>0.1.0</version>
  <description>PPO obstacle avoidance training environment for ROS 2 and Gazebo Sim.</description>
  <maintainer email="maintainer@example.com">ROS 2 PPO Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
